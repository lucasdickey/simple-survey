# Every provider below is OPTIONAL. With none set, the app runs against a local
# SQLite file (file:local.db / file:local-contacts.db), the dashboard is open,
# and email no-ops. Fill these in to go to production.
#
# You normally do not edit this file by hand — `stripe projects env --pull`
# writes the real values into `.env`. Note that the CLI names variables after
# the RESOURCE you created, so `--name analytics-db` produces
# ANALYTICS_DB_DATABASE_URL rather than TURSO_DATABASE_URL. The app resolves
# across both spellings (see lib/turso-config.ts), so either works.

# --- Turso — analytics DB (no PII) ---------------------------------------
# Also accepted: ANALYTICS_DB_*, PRIMARY_DB_*, SURVEY_DB_*
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Turso — contacts DB (PII only) --------------------------------------
# Required once the analytics DB is remote AND a survey collects email: email
# and clerk-id must live in a physically separate database. The app fails
# closed rather than co-locating personal data with responses.
# Also accepted: CONTACTS_DB_*
CONTACTS_DATABASE_URL=
CONTACTS_AUTH_TOKEN=

# --- Clerk (optional; gates /dashboard) ----------------------------------
# `stripe projects add clerk/auth` writes CLERK_ENVIRONMENTS instead — a JSON
# blob holding both environments. The app unpacks it automatically.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Twilio email (optional; admin notification on submit) ---------------
# Provisioned by `stripe projects add twilio/email` — this is Twilio SendGrid.
# Projects hands back OAuth client credentials, not a classic SG. API key.
TWILIO_ACCOUNT_SID=
TWILIO_OAUTH_CLIENT_ID=
TWILIO_OAUTH_CLIENT_SECRET=
# Must be a Twilio-verified sender.
TWILIO_EMAIL_FROM_ADDRESS=
TWILIO_EMAIL_FROM_NAME=

# --- Vercel (written by `stripe projects add vercel/project`) ------------
# Used by `npm run deploy`.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
VERCEL_TEAM_ID=
